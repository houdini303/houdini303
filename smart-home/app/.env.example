# Volitelné výchozí připojení k Home Assistantu.
# Pohodlnější je nastavit URL + token přímo v appce (tlačítko ⚙️) — uloží se do
# prohlížeče (localStorage) na daném zařízení. .env se hodí pro dev.
#
# URL běžící instance HA (bez lomítka na konci).
# POZOR na mixed-content: pokud appku servíruješ přes https://, musí i HA běžet
# přes https:// (reverzní proxy s TLS) — viz smart-home/08-vlastni-aplikace.md, sekce 8.6.
VITE_HASS_URL=http://homeassistant.local:8123

# Long-Lived Access Token z HA: profil (dole) → "Long-Lived Access Tokens".
VITE_HASS_TOKEN=

# Demo režim: true = běží bez HA na simulovaných datech (na první spuštění fajn).
# Když je prázdný token a není nastaveno připojení, appka spustí demo sama.
VITE_DEMO=false
